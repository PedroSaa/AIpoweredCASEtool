<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AicaseCli</RootNamespace>
    <AssemblyName>aicase</AssemblyName>
    <Description>AICASE CLI – Generates full-stack code from a project JSON definition</Description>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Override RuntimeIdentifier at publish time: dotnet publish -r win-x64 or linux-x64 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Template engine -->
    <PackageReference Include="Scriban" Version="5.9.0" />

    <!-- JSON Schema validation -->
    <PackageReference Include="NJsonSchema" Version="11.0.2" />

    <!-- System.Text.Json is included in .NET 8 SDK -->
  </ItemGroup>

</Project>
