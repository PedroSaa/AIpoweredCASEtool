{
  "ConnectionStrings": {
    "DefaultConnection": "Server={DatabaseServer};Database={DatabaseName};User Id={DatabaseUser};Password={DatabasePassword};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "{JwtSecretKey_MinimumLength_32_Characters}",
    "Issuer": "{ProjectName}",
    "Audience": "{ProjectName}-clients",
    "ExpiryMinutes": 480,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "{ProductionFrontendUrl}"
    ]
  },
  "RunMigrationsOnStartup": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
