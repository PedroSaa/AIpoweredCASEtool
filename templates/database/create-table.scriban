{{~ # SQL CREATE TABLE template – AICASE ~}}
-- =============================================================================
-- Table: {{ entity.table }}
-- Entity: {{ entity.name }}
-- Description: {{ entity.description }}
-- Generated by AICASE
-- =============================================================================

IF OBJECT_ID(N'[{{ schema }}].[{{ entity.table }}]', N'U') IS NOT NULL
    DROP TABLE [{{ schema }}].[{{ entity.table }}];
GO

CREATE TABLE [{{ schema }}].[{{ entity.table }}] (
    {{~ has_pk = false ~}}
    {{~ for field in entity.fields ~}}
    {{~ if field.is_pk ~}}
    {{~ has_pk = true ~}}
    [{{ field.name_pascal }}]     {{ field.sql_type }} NOT NULL IDENTITY(1,1),
    {{~ else ~}}
    [{{ field.name_pascal }}]     {{ field.sql_type }} {{ if field.required }}NOT NULL{{ else }}NULL{{ end }}{{ if field.default_value }} DEFAULT ({{ field.default_value }}){{ end }},
    {{~ end ~}}
    {{~ end ~}}
    {{~ # Foreign key columns for ManyToOne relations ~}}
    {{~ for rel in entity.relations ~}}
    {{~ if rel.type == "ManyToOne" && rel.field ~}}
    -- FK to {{ rel.target }}
    {{~ end ~}}
    {{~ end ~}}

    {{~ # Primary key constraint ~}}
    {{~ for field in entity.fields ~}}
    {{~ if field.is_pk ~}}
    CONSTRAINT [PK_{{ entity.table }}] PRIMARY KEY CLUSTERED ([{{ field.name_pascal }}] ASC)
    {{~ end ~}}
    {{~ end ~}}
);
GO

{{~ # Unique indexes ~}}
{{~ for field in entity.fields ~}}
{{~ if field.unique && !field.is_pk ~}}
-- Unique index on {{ field.name_pascal }}
CREATE UNIQUE NONCLUSTERED INDEX [UQ_{{ entity.table }}_{{ field.name_pascal }}]
    ON [{{ schema }}].[{{ entity.table }}] ([{{ field.name_pascal }}] ASC)
    WITH (IGNORE_DUP_KEY = OFF);
GO

{{~ end ~}}
{{~ end ~}}

{{~ # Foreign key constraints ~}}
{{~ for rel in entity.relations ~}}
{{~ if rel.type == "ManyToOne" && rel.field ~}}
{{~ # Find the target entity table ~}}
{{~ target_table = "" ~}}
{{~ for e in all_entities ~}}
{{~ if e.name == rel.target ~}}
{{~ target_table = e.table ~}}
{{~ end ~}}
{{~ end ~}}
ALTER TABLE [{{ schema }}].[{{ entity.table }}]
    ADD CONSTRAINT [FK_{{ entity.table }}_{{ rel.target }}]
    FOREIGN KEY ([{{ rel.field | string.upcase | string.slice 0 1 }}{{ rel.field | string.slice 1 }}])
    REFERENCES [{{ schema }}].[{{ target_table }}] ([{{ rel.target_field | string.upcase | string.slice 0 1 }}{{ rel.target_field | string.slice 1 }}])
    {{~ if rel.cascade ~}}
    ON DELETE CASCADE;
    {{~ else ~}}
    ON DELETE NO ACTION;
    {{~ end ~}}
GO

{{~ end ~}}
{{~ end ~}}

PRINT 'Table [{{ entity.table }}] created successfully.';
GO
