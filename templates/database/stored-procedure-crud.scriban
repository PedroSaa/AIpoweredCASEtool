CREATE PROCEDURE [{{ project.globalconfig?.databaseconfig?.schema ?? "dbo" }}].[SP_Update_{{ entity.tablename }}]
    @{{ entity.primarykey?.name ?? "Id" }} {{ entity.primarykey?.sqltype ?? "INT" }},
    {{- for field in entity.fields }}
    {{- if !field.ispk }}
    @{{ field.name }} {{ field.sqltype }}{{ if !field.isrequired }} = NULL{{ end }},
    {{- end }}
    {{- end }}
    @RowsAffected INT OUTPUT
AS
BEGIN
