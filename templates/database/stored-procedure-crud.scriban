-- ─── SP_GetAll_{{ entity.tablename }} ────────────────────────────────────────────────
IF OBJECT_ID('{{ project.globalconfig?.databaseconfig?.schema ?? "dbo" }}.SP_GetAll_{{ entity.tablename }}', 'P') IS NOT NULL
    DROP PROCEDURE [{{ project.globalconfig?.databaseconfig?.schema ?? "dbo" }}].[SP_GetAll_{{ entity.tablename }}];
GO

CREATE PROCEDURE [{{ project.globalconfig?.databaseconfig?.schema ?? "dbo" }}].[SP_GetAll_{{ entity.tablename }}]
    @Page       INT = 1,
    @PageSize   INT = 10,
    @OrderBy    NVARCHAR(50) = '{{ entity.primarykey?.name ?? "Id" }}',
    @OrderDesc  BIT = 0
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Offset INT = (@Page - 1) * @PageSize;
    DECLARE @TotalCount INT;

    SELECT @TotalCount = COUNT(*) FROM [{{ project.globalconfig?.databaseconfig?.schema ?? "dbo" }}].[{{ entity.tablename }}];

    SELECT
        {{- for field in entity.fields }}
        {{- is_last = for.last }}
        [{{ field.name }}]{{ if !is_last }},{{ end }}
        {{- end }}
        ,@TotalCount AS TotalCount
    FROM [{{ project.globalconfig?.databaseconfig?.schema ?? "dbo" }}].[{{ entity.tablename }}]
    ORDER BY [{{ entity.primarykey?.name ?? "Id" }}]
    OFFSET @Offset ROWS FETCH NEXT @PageSize ROWS ONLY;
END
GO

