{{~ # SQL CRUD Stored Procedures template – AICASE ~}}
-- =============================================================================
-- CRUD Stored Procedures for: {{ entity.name }} ({{ entity.table }})
-- Generated by AICASE
-- =============================================================================

{{~ pk = entity.primary_key ~}}
{{~ non_pk_fields = entity.fields | array.filter @(do; ret !$0.is_pk; end) ~}}

-- ─── sp_{{ entity.name }}_Insert ─────────────────────────────────────────────
IF OBJECT_ID(N'[{{ schema }}].[sp_{{ entity.name }}_Insert]', 'P') IS NOT NULL
    DROP PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_Insert];
GO

CREATE PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_Insert]
    {{~ for field in non_pk_fields ~}}
    @{{ field.name_pascal }} {{ field.sql_type }}{{~ if !field.required ~}} = NULL{{~ end ~}}{{~ if !for.last ~}},{{~ end ~}}
    {{~ end ~}}
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    INSERT INTO [{{ schema }}].[{{ entity.table }}] (
        {{~ for field in non_pk_fields ~}}
        [{{ field.name_pascal }}]{{~ if !for.last ~}},{{~ end ~}}
        {{~ end ~}}
    ) VALUES (
        {{~ for field in non_pk_fields ~}}
        @{{ field.name_pascal }}{{~ if !for.last ~}},{{~ end ~}}
        {{~ end ~}}
    );

    SELECT SCOPE_IDENTITY() AS NewId;
END;
GO

-- ─── sp_{{ entity.name }}_Update ─────────────────────────────────────────────
IF OBJECT_ID(N'[{{ schema }}].[sp_{{ entity.name }}_Update]', 'P') IS NOT NULL
    DROP PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_Update];
GO

CREATE PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_Update]
    @{{ pk.name_pascal }} {{ pk.sql_type }},
    {{~ for field in non_pk_fields ~}}
    @{{ field.name_pascal }} {{ field.sql_type }}{{~ if !field.required ~}} = NULL{{~ end ~}}{{~ if !for.last ~}},{{~ end ~}}
    {{~ end ~}}
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE [{{ schema }}].[{{ entity.table }}]
    SET
        {{~ for field in non_pk_fields ~}}
        [{{ field.name_pascal }}] = @{{ field.name_pascal }}{{~ if !for.last ~}},{{~ end ~}}
        {{~ end ~}}
    WHERE [{{ pk.name_pascal }}] = @{{ pk.name_pascal }};

    SELECT @@ROWCOUNT AS RowsAffected;
END;
GO

-- ─── sp_{{ entity.name }}_Delete ─────────────────────────────────────────────
IF OBJECT_ID(N'[{{ schema }}].[sp_{{ entity.name }}_Delete]', 'P') IS NOT NULL
    DROP PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_Delete];
GO

CREATE PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_Delete]
    @{{ pk.name_pascal }} {{ pk.sql_type }}
AS
BEGIN
    SET NOCOUNT ON;

    DELETE FROM [{{ schema }}].[{{ entity.table }}]
    WHERE [{{ pk.name_pascal }}] = @{{ pk.name_pascal }};

    SELECT @@ROWCOUNT AS RowsAffected;
END;
GO

-- ─── sp_{{ entity.name }}_GetById ────────────────────────────────────────────
IF OBJECT_ID(N'[{{ schema }}].[sp_{{ entity.name }}_GetById]', 'P') IS NOT NULL
    DROP PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_GetById];
GO

CREATE PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_GetById]
    @{{ pk.name_pascal }} {{ pk.sql_type }}
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        t.[{{ pk.name_pascal }}],
        {{~ for field in non_pk_fields ~}}
        t.[{{ field.name_pascal }}]{{~ if !for.last ~}},{{~ end ~}}
        {{~ end ~}}
        {{~ for rel in entity.relations ~}}
        {{~ if rel.type == "ManyToOne" ~}}
        {{~ # Navigation label – assumes target has a 'nombre' or 'name' field ~}}
        -- , r.Nombre AS {{ rel.target }}Nombre
        {{~ end ~}}
        {{~ end ~}}
    FROM [{{ schema }}].[{{ entity.table }}] t
    {{~ for rel in entity.relations ~}}
    {{~ if rel.type == "ManyToOne" ~}}
    {{~ target_table = "" ~}}
    {{~ for e in all_entities ~}}{{~ if e.name == rel.target ~}}{{~ target_table = e.table ~}}{{~ end ~}}{{~ end ~}}
    LEFT JOIN [{{ schema }}].[{{ target_table }}] r ON t.[{{ rel.field | string.upcase | string.slice 0 1 }}{{ rel.field | string.slice 1 }}] = r.[{{ rel.target_field | string.upcase | string.slice 0 1 }}{{ rel.target_field | string.slice 1 }}]
    {{~ end ~}}
    {{~ end ~}}
    WHERE t.[{{ pk.name_pascal }}] = @{{ pk.name_pascal }};
END;
GO

-- ─── sp_{{ entity.name }}_GetAll ─────────────────────────────────────────────
IF OBJECT_ID(N'[{{ schema }}].[sp_{{ entity.name }}_GetAll]', 'P') IS NOT NULL
    DROP PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_GetAll];
GO

CREATE PROCEDURE [{{ schema }}].[sp_{{ entity.name }}_GetAll]
    @Page       INT          = 1,
    @PageSize   INT          = 10,
    @SortField  NVARCHAR(50) = '{{ pk.name_pascal }}',
    @SortDir    NVARCHAR(4)  = 'ASC'
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Offset INT = (@Page - 1) * @PageSize;
    DECLARE @TotalRows INT;

    SELECT @TotalRows = COUNT(*) FROM [{{ schema }}].[{{ entity.table }}];

    SELECT
        @TotalRows AS TotalRows,
        t.[{{ pk.name_pascal }}],
        {{~ for field in non_pk_fields ~}}
        t.[{{ field.name_pascal }}]{{~ if !for.last ~}},{{~ end ~}}
        {{~ end ~}}
    FROM [{{ schema }}].[{{ entity.table }}] t
    {{~ for rel in entity.relations ~}}
    {{~ if rel.type == "ManyToOne" ~}}
    {{~ target_table = "" ~}}
    {{~ for e in all_entities ~}}{{~ if e.name == rel.target ~}}{{~ target_table = e.table ~}}{{~ end ~}}{{~ end ~}}
    LEFT JOIN [{{ schema }}].[{{ target_table }}] r{{ rel.target }} ON t.[{{ rel.field | string.upcase | string.slice 0 1 }}{{ rel.field | string.slice 1 }}] = r{{ rel.target }}.[{{ rel.target_field | string.upcase | string.slice 0 1 }}{{ rel.target_field | string.slice 1 }}]
    {{~ end ~}}
    {{~ end ~}}
    ORDER BY
        CASE WHEN @SortDir = 'ASC'  THEN (SELECT NULL) END ASC,
        CASE WHEN @SortDir = 'DESC' THEN (SELECT NULL) END DESC,
        t.[{{ pk.name_pascal }}] ASC
    OFFSET @Offset ROWS FETCH NEXT @PageSize ROWS ONLY;
END;
GO

PRINT 'Stored procedures for {{ entity.name }} created successfully.';
GO
