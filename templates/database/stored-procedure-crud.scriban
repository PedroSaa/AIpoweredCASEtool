CREATE PROCEDURE [{{ project.schema }}].[sp_{{ entity.nombre }}_Delete]
    @Id INT
AS
BEGIN
    SET NOCOUNT ON;
    DELETE FROM [{{ project.schema }}].[{{ entity.tabla }}]
    WHERE [{{ entity.primary_key.nombre ?? "Id" }}] = @Id;
    SELECT @@ROWCOUNT AS RowsAffected;
END
GO

