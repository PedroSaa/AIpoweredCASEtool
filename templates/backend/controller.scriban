    {{~ if array.contains entity.api_config.operations "getAll" ~}}
    /// <summary>Get paginated list of {{ entity.name }}.</summary>
    [HttpGet]
    {{~ if entity.api_config.roles.get_all.size > 0 ~}}
    [Authorize(Roles = "{{ entity.api_config.roles.get_all | array.join ", " }}")]
    {{~ end ~}}
    [ProducesResponseType(typeof(object), StatusCodes.Status200OK)]
    public async Task<IActionResult> GetAll(
        [FromQuery] int page = 1,
        [FromQuery] int pageSize = 10,
        [FromQuery] string? sortField = null,
        [FromQuery] string? sortDirection = "asc")
    {
        var (items, total) = await _service.GetAllAsync(page, pageSize, sortField, sortDirection);
        return Ok(new { data = items, total, page, pageSize });
    }
    {{~ end ~}}

    {{~ if array.contains entity.api_config.operations "getById" ~}}
    /// <summary>Get {{ entity.name }} by ID.</summary>
    [HttpGet("{id}")]
    {{~ if entity.api_config.roles.get_by_id.size > 0 ~}}
    [Authorize(Roles = "{{ entity.api_config.roles.get_by_id | array.join ", " }}")]
    {{~ end ~}}
    [ProducesResponseType(typeof({{ entity.name }}ResponseDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> GetById({{ entity.primary_key.csharp_type }} id)
    {
        var result = await _service.GetByIdAsync(id);
        return result is null ? NotFound() : Ok(result);
    }
    {{~ end ~}}

    {{~ if array.contains entity.api_config.operations "create" ~}}
    /// <summary>Create a new {{ entity.name }}.</summary>
    [HttpPost]
    {{~ if entity.api_config.roles.create.size > 0 ~}}
    [Authorize(Roles = "{{ entity.api_config.roles.create | array.join ", " }}")]
    {{~ end ~}}
    [ProducesResponseType(typeof({{ entity.name }}ResponseDto), StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> Create([FromBody] {{ entity.name }}CreateDto dto)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        try
        {
            var created = await _service.CreateAsync(dto);
            return CreatedAtAction(nameof(GetById), new { id = created.{{ entity.primary_key.name_pascal }} }, created);
        }
        catch (InvalidOperationException ex)
        {
            return BadRequest(new { message = ex.Message });
        }
    }
    {{~ end ~}}

    {{~ if array.contains entity.api_config.operations "update" ~}}
    /// <summary>Update an existing {{ entity.name }}.</summary>
    [HttpPut("{id}")]
    {{~ if entity.api_config.roles.update.size > 0 ~}}
    [Authorize(Roles = "{{ entity.api_config.roles.update | array.join ", " }}")]
    {{~ end ~}}
    [ProducesResponseType(typeof({{ entity.name }}ResponseDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> Update({{ entity.primary_key.csharp_type }} id, [FromBody] {{ entity.name }}UpdateDto dto)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        try
        {
            var updated = await _service.UpdateAsync(id, dto);
            return updated is null ? NotFound() : Ok(updated);
        }
        catch (InvalidOperationException ex)
        {
            return BadRequest(new { message = ex.Message });
        }
    }
    {{~ end ~}}

    {{~ if array.contains entity.api_config.operations "delete" ~}}
    /// <summary>Delete a {{ entity.name }}.</summary>
