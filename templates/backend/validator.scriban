{{~ # FluentValidation Validator template – AICASE ~}}
using FluentValidation;
using {{ namespace }}.DTOs;

namespace {{ namespace }}.Validators;

/// <summary>
/// FluentValidation validator for {{ entity.name }}CreateDto.
/// Generated by AICASE.
/// </summary>
public class {{ entity.name }}CreateValidator : AbstractValidator<{{ entity.name }}CreateDto>
{
    public {{ entity.name }}CreateValidator()
    {
        {{~ for field in entity.fields ~}}
        {{~ if field.is_pk == false ~}}
        // {{ field.name_pascal }}
        {{~ if field.required ~}}
        RuleFor(x => x.{{ field.name_pascal }})
            .NotEmpty().WithMessage("{{ field.name_pascal }} es requerido.")
            {{~ if field.validation && field.validation.min_length ~}}
            .MinimumLength({{ field.validation.min_length }}).WithMessage("{{ field.name_pascal }} debe tener al menos {{ field.validation.min_length }} caracteres.")
            {{~ end ~}}
            {{~ if field.validation && field.validation.max_length ~}}
            .MaximumLength({{ field.validation.max_length }}).WithMessage("{{ field.name_pascal }} no puede superar {{ field.validation.max_length }} caracteres.")
            {{~ else if field.length ~}}
            .MaximumLength({{ field.length }}).WithMessage("{{ field.name_pascal }} no puede superar {{ field.length }} caracteres.")
            {{~ end ~}}
            {{~ if field.validation && field.validation.email ~}}
            .EmailAddress().WithMessage("{{ field.name_pascal }} debe ser un email válido.")
            {{~ end ~}}
            {{~ if field.validation && field.validation.regex ~}}
            .Matches(@"{{ field.validation.regex }}").WithMessage("{{ field.validation.regex_message ?? (field.name_pascal + " tiene un formato inválido.") }}")
            {{~ end ~}}
            ;
        {{~ else ~}}
        {{~ if field.validation ~}}
        RuleFor(x => x.{{ field.name_pascal }})
            {{~ if field.validation.min ~}}
            .GreaterThanOrEqualTo({{ field.validation.min }}).WithMessage("{{ field.name_pascal }} debe ser mayor o igual a {{ field.validation.min }}.")
            {{~ end ~}}
            {{~ if field.validation.max ~}}
            .LessThanOrEqualTo({{ field.validation.max }}).WithMessage("{{ field.name_pascal }} no puede superar {{ field.validation.max }}.")
            {{~ end ~}}
            {{~ if field.validation.email ~}}
            .EmailAddress().WithMessage("{{ field.name_pascal }} debe ser un email válido.")
            {{~ end ~}}
            ;
        {{~ end ~}}
        {{~ end ~}}

        {{~ end ~}}
        {{~ end ~}}
    }
}

/// <summary>
/// FluentValidation validator for {{ entity.name }}UpdateDto.
/// Generated by AICASE.
/// </summary>
public class {{ entity.name }}UpdateValidator : AbstractValidator<{{ entity.name }}UpdateDto>
{
    public {{ entity.name }}UpdateValidator()
    {
        {{~ for field in entity.fields ~}}
        {{~ if field.is_pk == false && field.required ~}}
        RuleFor(x => x.{{ field.name_pascal }})
            .NotEmpty().WithMessage("{{ field.name_pascal }} es requerido.")
            {{~ if field.length ~}}
            .MaximumLength({{ field.length }}).WithMessage("{{ field.name_pascal }} no puede superar {{ field.length }} caracteres.")
            {{~ end ~}}
            ;
        {{~ end ~}}
        {{~ end ~}}
    }
}
