{{~ # Repository Interface template – AICASE ~}}
namespace {{ namespace }}.Repositories;

/// <summary>
/// Repository interface for {{ entity.name }} entity.
/// Generated by AICASE.
/// </summary>
public interface I{{ entity.name }}Repository
{
    Task<IEnumerable<{{ namespace }}.Models.{{ entity.name }}>> GetAllAsync(
        int page = 1, int pageSize = 10,
        string? sortField = null, string? sortDirection = "asc");

    Task<int> GetCountAsync();

    Task<{{ namespace }}.Models.{{ entity.name }}?> GetByIdAsync({{ entity.primary_key.csharp_type }} id);

    Task<{{ namespace }}.Models.{{ entity.name }}> CreateAsync({{ namespace }}.Models.{{ entity.name }} entity);

    Task<{{ namespace }}.Models.{{ entity.name }}?> UpdateAsync({{ namespace }}.Models.{{ entity.name }} entity);

    Task<bool> DeleteAsync({{ entity.primary_key.csharp_type }} id);

    Task<bool> ExistsAsync({{ entity.primary_key.csharp_type }} id);

    {{~ # Unique field existence checks ~}}
    {{~ for field in entity.fields ~}}
    {{~ if field.unique && !field.is_pk ~}}
    Task<bool> {{ field.name_pascal }}ExistsAsync({{ field.csharp_type }} {{ field.name }}, {{ entity.primary_key.csharp_type }}? excludeId = null);
    {{~ end ~}}
    {{~ end ~}}
}
