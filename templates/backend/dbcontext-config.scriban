{{~ # EF Core Entity Configuration (Fluent API) – AICASE ~}}
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;
using {{ namespace }}.Models;

namespace {{ namespace }}.Data.Configurations;

/// <summary>
/// EF Core Fluent API configuration for {{ entity.name }}.
/// Generated by AICASE.
/// </summary>
public class {{ entity.name }}Configuration : IEntityTypeConfiguration<{{ entity.name }}>
{
    public void Configure(EntityTypeBuilder<{{ entity.name }}> builder)
    {
        builder.ToTable("{{ entity.table }}");

        // ── Primary Key ───────────────────────────────────────────────────
        {{~ for field in entity.fields ~}}
        {{~ if field.is_pk ~}}
        builder.HasKey(e => e.{{ field.name_pascal }});
        {{~ if field.auto_increment ~}}
        builder.Property(e => e.{{ field.name_pascal }}).ValueGeneratedOnAdd();
        {{~ end ~}}
        {{~ end ~}}
        {{~ end ~}}

        // ── Properties ────────────────────────────────────────────────────
        {{~ for field in entity.fields ~}}
        {{~ if field.is_pk == false ~}}
        builder.Property(e => e.{{ field.name_pascal }})
            {{~ if field.required && field.type == "string" ~}}
            .IsRequired()
            {{~ end ~}}
            {{~ if field.length ~}}
            .HasMaxLength({{ field.length }})
            {{~ end ~}}
            {{~ if field.type == "decimal" ~}}
            .HasColumnType("decimal({{ field.precision ?? 18 }}, {{ field.scale ?? 2 }})")
            {{~ else if field.type == "date" ~}}
            .HasColumnType("datetime2")
            {{~ else if field.type == "bool" ~}}
            .HasColumnType("bit")
            {{~ else if field.type == "string" ~}}
            .HasColumnType("nvarchar({{ field.length ?? "max" }})")
            {{~ else if field.type == "guid" ~}}
            .HasColumnType("uniqueidentifier")
            {{~ end ~}}
            {{~ if field.default_value ~}}
            .HasDefaultValue({{ field.default_value }})
            {{~ end ~}}
            ;

        {{~ end ~}}
        {{~ end ~}}

        // ── Unique Indexes ────────────────────────────────────────────────
        {{~ for field in entity.fields ~}}
        {{~ if field.unique && !field.is_pk ~}}
        builder.HasIndex(e => e.{{ field.name_pascal }}).IsUnique();
        {{~ end ~}}
        {{~ end ~}}

        // ── Relations ─────────────────────────────────────────────────────
        {{~ for rel in entity.relations ~}}
        {{~ if rel.type == "ManyToOne" ~}}
        builder.HasOne(e => e.{{ rel.target }})
               .WithMany()
               .HasForeignKey(e => e.{{ rel.field }})
               {{~ if !rel.nullable ~}}
               .IsRequired()
               {{~ end ~}}
               {{~ if rel.cascade ~}}
               .OnDelete(DeleteBehavior.Cascade);
               {{~ else ~}}
               .OnDelete(DeleteBehavior.Restrict);
               {{~ end ~}}
        {{~ else if rel.type == "OneToMany" ~}}
        builder.HasMany(e => e.{{ rel.target }}s)
               .WithOne()
               .HasForeignKey("{{ rel.field }}")
               {{~ if rel.cascade ~}}
               .OnDelete(DeleteBehavior.Cascade);
               {{~ else ~}}
               .OnDelete(DeleteBehavior.Restrict);
               {{~ end ~}}
        {{~ else if rel.type == "ManyToMany" ~}}
        builder.HasMany(e => e.{{ rel.target }}s)
               .WithMany()
               .UsingEntity(j => j.ToTable("{{ rel.join_table }}"));
        {{~ end ~}}
        {{~ end ~}}
    }
}
