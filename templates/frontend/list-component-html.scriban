<div class="container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>{{ entity.screens?.list?.title ?? entity.name + "s" }}</h2>
    {{- if entity.screens?.list?.actions | array.contains "crear" }}
    <button class="btn btn-primary" (click)="onCreate()">
      <i class="bi bi-plus-circle me-1"></i> Nuevo
    </button>
    {{- end }}
  </div>

  <!-- Mensajes de error -->
  <div *ngIf="errorMessage" class="alert alert-danger alert-dismissible">
    {{ "{{" }} errorMessage {{ "}}" }}
    <button type="button" class="btn-close" (click)="errorMessage=''"></button>
  </div>

  <!-- Tabla -->
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div *ngIf="loading" class="text-center p-4">
        <div class="spinner-border text-primary"></div>
      </div>

      <table *ngIf="!loading" class="table table-striped table-hover mb-0">
        <thead class="table-dark">
          <tr>
            {{- for col in entity.screens?.list?.columns ?? [] }}
            <th (click)="onSort('{{ col }}')" style="cursor:pointer">
              {{ col }}
              <i *ngIf="orderBy === '{{ col }}'"
                 [class]="orderDesc ? 'bi bi-sort-down' : 'bi bi-sort-up'"></i>
            </th>
            {{- end }}
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <tr *ngFor="let item of items">
            {{- for col in entity.screens?.list?.columns ?? [] }}
            <td>{{ "{{" }} item.{{ col | to_camel_case }} {{ "}}" }}</td>
            {{- end }}
            <td>
              {{- if entity.screens?.list?.actions | array.contains "editar" }}
              <button class="btn btn-sm btn-outline-primary me-1" (click)="onEdit(item)" title="Editar">
                <i class="bi bi-pencil"></i>
              </button>
              {{- end }}
              {{- if entity.screens?.list?.actions | array.contains "eliminar" }}
              <button class="btn btn-sm btn-outline-danger" (click)="onDelete(item)" title="Eliminar">
                <i class="bi bi-trash"></i>
              </button>
              {{- end }}
            </td>
          </tr>
          <tr *ngIf="items.length === 0">
            <td colspan="{{ (entity.screens?.list?.columns | array.size) + 1 }}" class="text-center text-muted py-4">
              No hay registros para mostrar
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Paginación -->
    <div class="card-footer d-flex justify-content-between align-items-center">
      <small class="text-muted">Total: {{ "{{" }} totalCount {{ "}}" }} registros</small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item" [class.disabled]="page === 1">
            <a class="page-link" (click)="onPageChange(page - 1)">‹</a>
          </li>
          <li class="page-item" *ngFor="let p of [].constructor(totalPages); let i = index"
              [class.active]="page === i + 1">
            <a class="page-link" (click)="onPageChange(i + 1)">{{ "{{" }} i + 1 {{ "}}" }}</a>
          </li>
          <li class="page-item" [class.disabled]="page === totalPages">
            <a class="page-link" (click)="onPageChange(page + 1)">›</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>
