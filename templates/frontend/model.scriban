{{~ # TypeScript Interface template – AICASE ~}}
/**
 * {{ entity.description }}
 * Generated by AICASE from entity '{{ entity.name }}'.
 */
export interface {{ entity.name }} {
  {{~ for field in entity.fields ~}}
  /** {{ field.description }} */
  {{ field.name }}{{ if !field.required }}?{{ end }}: {{ field.type_script_type }};
  {{~ end ~}}
  {{~ for rel in entity.relations ~}}
  {{~ if rel.type == "ManyToOne" ~}}
  {{ rel.target | string.downcase }}?: {{ rel.target }};
  {{~ end ~}}
  {{~ end ~}}
}

/** DTO for creating a new {{ entity.name }} */
export interface {{ entity.name }}CreateDto {
  {{~ for field in entity.fields ~}}
  {{~ if !field.is_pk ~}}
  {{ field.name }}{{ if !field.required }}?{{ end }}: {{ field.type_script_type }};
  {{~ end ~}}
  {{~ end ~}}
}

/** DTO for updating an existing {{ entity.name }} */
export interface {{ entity.name }}UpdateDto {
  {{~ for field in entity.fields ~}}
  {{~ if !field.is_pk ~}}
  {{ field.name }}?: {{ field.type_script_type }};
  {{~ end ~}}
  {{~ end ~}}
}
